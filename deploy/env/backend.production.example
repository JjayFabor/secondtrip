# Copy these names into Render. Do not use this file as a secret store.
# Example host layout:
#   frontend https://secondtrip.jjayfabor.com
#   API      https://api.secondtrip.jjayfabor.com
#   cookie   .secondtrip.jjayfabor.com

APP_ENV=production
APP_NAME=SecondTrip
APP_SECRET=REPLACE_ME
APP_URL=https://api.secondtrip.jjayfabor.com
FRONTEND_URL=https://secondtrip.jjayfabor.com
CORS_ALLOWED_ORIGINS=["https://secondtrip.jjayfabor.com"]
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# Pooled Neon URL using the non-owner, RLS-bound secondtrip_app role.
DATABASE_URL=postgresql+asyncpg://secondtrip_app:REPLACE_ME@REPLACE_ME-pooler/neondb
# Direct Neon URL using the migration owner. Never use this for the running app.
DATABASE_URL_MIGRATIONS=postgresql+asyncpg://REPLACE_ME:REPLACE_ME@REPLACE_ME/neondb
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=1800
DB_STATEMENT_TIMEOUT_MS=30000
DB_ECHO=false

SESSION_COOKIE_NAME=st_session
SESSION_IDLE_TIMEOUT_DAYS=14
SESSION_ABSOLUTE_TIMEOUT_DAYS=30
COOKIE_DOMAIN=.secondtrip.jjayfabor.com
COOKIE_SECURE=true
CSRF_COOKIE_NAME=st_csrf

STORAGE_PROVIDER=r2
STORAGE_BUCKET=secondtrip-production
STORAGE_ENDPOINT_URL=https://REPLACE_ME.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=REPLACE_ME
STORAGE_SECRET_ACCESS_KEY=REPLACE_ME
STORAGE_REGION=auto
STORAGE_SIGNED_URL_TTL_SECONDS=300
STORAGE_UPLOAD_URL_TTL_SECONDS=900

WORKER_ENABLED=true
WORKER_CONCURRENCY=2
WORKER_BATCH_SIZE=5
WORKER_POLL_MIN_SECONDS=0.5
WORKER_POLL_MAX_SECONDS=5
WORKER_HEARTBEAT_SECONDS=15
WORKER_STALE_AFTER_SECONDS=120
JOB_MAX_ATTEMPTS=5
JOB_BACKOFF_BASE_SECONDS=10
JOB_BACKOFF_MAX_SECONDS=3600

IMPORT_MAX_FILE_BYTES=524288000
IMPORT_MAX_ROWS=2000000
IMPORT_CHUNK_SIZE=500
IMPORT_MAX_FIELD_BYTES=32768
IMPORT_MAX_COLUMNS=200

DETECTION_DEFAULT_WINDOW_DAYS=30
DETECTION_DEFAULT_MIN_SCORE_TO_SURFACE=40
DETECTION_MAX_FOLLOWUPS_PER_JOB=25

EMAIL_PROVIDER=resend
EMAIL_API_KEY=REPLACE_ME
EMAIL_FROM_ADDRESS=noreply@mail.secondtrip.jjayfabor.com
EMAIL_FROM_NAME=SecondTrip

BILLING_PROVIDER=noop
