# See docs/architecture/17-configuration.md for the full specification.
# Copy to .env for local development. Never commit a real .env.

APP_ENV=local
APP_NAME=SecondTrip
APP_SECRET=dev-secret-change-me-please-32-chars-min
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=console

# Two roles, two URLs — see 02-multi-tenancy.md §2. Local Docker Postgres
# from docker-compose.yml at the repo root (docker compose up -d).
DATABASE_URL=postgresql+asyncpg://secondtrip_app:secondtrip_app_dev_only@localhost:5439/secondtrip_dev
DATABASE_URL_MIGRATIONS=postgresql+asyncpg://secondtrip_owner:secondtrip_owner_dev_only@localhost:5439/secondtrip_dev
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=1800
DB_STATEMENT_TIMEOUT_MS=30000
DB_ECHO=false
