# See docs/architecture/17-configuration.md for the full specification.
# Copy to .env for local development. Never commit a real .env.

APP_ENV=local
APP_NAME=SecondTrip
APP_SECRET=dev-secret-change-me-please-32-chars-min
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=console

# Two roles, two URLs — see 02-multi-tenancy.md §2. Local Docker Postgres
# from docker-compose.yml at the repo root (docker compose up -d).
DATABASE_URL=postgresql+asyncpg://secondtrip_app:secondtrip_app_dev_only@localhost:5439/secondtrip_dev
DATABASE_URL_MIGRATIONS=postgresql+asyncpg://secondtrip_owner:secondtrip_owner_dev_only@localhost:5439/secondtrip_dev
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=1800
DB_STATEMENT_TIMEOUT_MS=30000
DB_ECHO=false

# Object storage — local development uses a private filesystem directory.
# Staging/production use one private R2 bucket per environment.
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./.storage
STORAGE_SIGNED_URL_TTL_SECONDS=300
STORAGE_UPLOAD_URL_TTL_SECONDS=900
# STORAGE_BUCKET=secondtrip-dev
# STORAGE_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_REGION=auto
# Configure the private bucket's browser CORS rule from infra/r2/cors.example.json.

# In-process PostgreSQL worker. Disable on the API only after deploying a
# separate worker process that runs the same code.
WORKER_ENABLED=true
WORKER_CONCURRENCY=2
WORKER_BATCH_SIZE=5
WORKER_POLL_MIN_SECONDS=0.5
WORKER_POLL_MAX_SECONDS=5
WORKER_HEARTBEAT_SECONDS=15
WORKER_STALE_AFTER_SECONDS=120
JOB_MAX_ATTEMPTS=5
JOB_BACKOFF_BASE_SECONDS=10
JOB_BACKOFF_MAX_SECONDS=3600

# Import hard ceilings. Plan entitlements apply lower customer limits.
IMPORT_MAX_FILE_BYTES=524288000
IMPORT_MAX_ROWS=2000000
IMPORT_CHUNK_SIZE=500
IMPORT_MAX_FIELD_BYTES=32768
IMPORT_MAX_COLUMNS=200

# Defaults copied into each organization's immutable detection rule-set version 1.
DETECTION_DEFAULT_WINDOW_DAYS=30
DETECTION_DEFAULT_MIN_SCORE_TO_SURFACE=40
DETECTION_MAX_FOLLOWUPS_PER_JOB=25

# V1 has entitlements but no payment processor.
BILLING_PROVIDER=noop

# Sessions & cookies — see 03-authentication.md §2. cookie_domain is unset
# locally (frontend and API are different localhost ports); set it to a
# shared parent domain (e.g. .secondtrip.example.com) in staging/prod.
SESSION_COOKIE_NAME=st_session
# COOKIE_DOMAIN=.secondtrip.example.com
SESSION_IDLE_TIMEOUT_DAYS=14
SESSION_ABSOLUTE_TIMEOUT_DAYS=30
COOKIE_SECURE=false
CSRF_COOKIE_NAME=st_csrf
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60
INVITATION_TTL_DAYS=7
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# Email — console prints the rendered email (with its link) to stdout,
# so local dev never needs a real Resend API key.
EMAIL_PROVIDER=console
# EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=noreply@secondtrip.example.com
EMAIL_FROM_NAME=SecondTrip
# Required to enable POST /api/v1/contact. Keep unset locally unless
# contact delivery is being exercised with a real inbox.
# CONTACT_RECIPIENT_ADDRESS=support@example.com
CONTACT_IP_LIMIT=5
CONTACT_IP_WINDOW_SECONDS=3600

# Local-only `make seed-demo` controls. DEMO_RESET rebuilds only the reserved demo tenant.
DEMO_PASSWORD=SecondTripDemo-2026!
DEMO_RESET=false
